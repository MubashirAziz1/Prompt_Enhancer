<Window x:Class="PromptEnhancer.WinUI.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Prompt Enhancer — WinUI migration editor">
    <Grid x:Name="Root" Padding="24" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Height="{Binding ActualHeight, ElementName=Viewport}" MinHeight="620" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Prompt Enhancer" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock Text="Turn a rough idea into a clear English prompt." TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="SettingsButton" Grid.Column="1" Content="Settings" VerticalAlignment="Top"
                            AutomationProperties.AutomationId="Settings" TabIndex="0" Click="OpenSettings" />
                </Grid>
                <TextBox x:Name="RoughPrompt" Grid.Row="1" Header="Rough prompt" AcceptsReturn="True"
                         TextWrapping="Wrap" FontSize="15" MaxLength="32000" TabIndex="1"
                         AutomationProperties.AutomationId="RoughPrompt" AutomationProperties.Name="Rough prompt"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <Grid Grid.Row="2">
                    <Button x:Name="PasteButton" Content="Paste" Click="Paste" TabIndex="2"
                            AutomationProperties.AutomationId="Paste" />
                    <Button x:Name="EnhanceButton" Content="Enhance" Click="Enhance" HorizontalAlignment="Right"
                            Style="{StaticResource AccentButtonStyle}" MinWidth="128" TabIndex="3"
                            AutomationProperties.AutomationId="Enhance" />
                </Grid>
                <TextBox x:Name="EnhancedPrompt" Grid.Row="3" Header="Enhanced prompt — review and edit" AcceptsReturn="True"
                         TextWrapping="Wrap" FontSize="15" MaxLength="32000" TabIndex="4" TextChanging="ResultChanging"
                         AutomationProperties.AutomationId="EnhancedPrompt" AutomationProperties.Name="Enhanced prompt"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <Button x:Name="CopyButton" Grid.Row="4" Content="Copy" Click="Copy" HorizontalAlignment="Right"
                        IsEnabled="False" MinWidth="128" TabIndex="5" AutomationProperties.AutomationId="Copy"
                        AutomationProperties.Name="Copy enhanced prompt" />
                <StackPanel Grid.Row="5" Spacing="8">
                    <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed"
                                 AutomationProperties.Name="Enhancing" AutomationProperties.AutomationId="Progress" />
                    <TextBlock x:Name="Status" Text="Ready. Add your API key in Settings to begin." TextWrapping="Wrap"
                               AutomationProperties.AutomationId="Status" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <TextBlock Grid.Row="6" Text="Enhance sends your text to your cloud provider. Usage charges may apply."
                           TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
