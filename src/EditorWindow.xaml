<Window x:Class="PromptEnhancer.WinUI.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Prompt Enhancer">
    <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt" /></Window.SystemBackdrop>
    <Grid x:Name="Root" RequestedTheme="Dark" Background="Transparent">
        <Grid.Resources>
            <SolidColorBrush x:Key="PanelBrush" Color="#20212D" />
            <SolidColorBrush x:Key="ComposerBrush" Color="#17181E" />

            <SolidColorBrush x:Key="MutedBrush" Color="#B4B1C4" />
            <Style x:Key="QuietButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#B4B1C4" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
                <Setter Property="Background" Value="#18FFFFFF" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="PromptField" TargetType="TextBox">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#F3F2F7" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4,8" />
                <Setter Property="SelectionHighlightColor" Value="#6E6596" />
            </Style>
                <Flyout x:Name="SessionFlyout" Placement="BottomEdgeAlignedLeft">
                    <StackPanel Spacing="4" MinWidth="170" RequestedTheme="Dark">
                        <Button Content="Hide" Click="Hide" TabIndex="8" HorizontalAlignment="Stretch" Style="{StaticResource QuietButton}"
                                AutomationProperties.AutomationId="Hide" />
                        <Button Content="Quit" Click="Quit" TabIndex="9" HorizontalAlignment="Stretch" Style="{StaticResource QuietButton}"
                                AutomationProperties.AutomationId="Quit" />
                    </StackPanel>
                </Flyout>
        </Grid.Resources>
        <Border Margin="5" Padding="10,4,10,10" CornerRadius="16" BorderBrush="#55494960" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.65,1">
                    <GradientStop Color="#DC3B344F" Offset="0" />
                    <GradientStop Color="#ED272A3B" Offset="0.5" />
                    <GradientStop Color="#F0202637" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid RowSpacing="4">
                <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" /><ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="32" /><ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ClearButton" Style="{StaticResource ToolbarButton}" Click="Clear" TabIndex="6"
                            AutomationProperties.AutomationId="Clear" AutomationProperties.Name="Clear prompts"
                            ToolTipService.ToolTip="Clear prompts" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Click="OpenSessionMenu" TabIndex="7"
                            AutomationProperties.AutomationId="SessionMenu" AutomationProperties.Name="Session menu"
                            ToolTipService.ToolTip="Session menu" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                    </Button>
                    <Grid x:Name="DragRegion" Grid.Column="2" Background="Transparent">
                        <TextBlock Text="Prompt Enhancer" FontFamily="Segoe UI Variable Text" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                    <Button x:Name="SettingsButton" Grid.Column="3" Style="{StaticResource ToolbarButton}" Click="OpenSettings" TabIndex="0"
                            AutomationProperties.AutomationId="Settings" AutomationProperties.Name="Settings"
                            ToolTipService.ToolTip="Settings" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource ToolbarButton}" Click="Collapse" TabIndex="10"
                            AutomationProperties.AutomationId="Collapse" AutomationProperties.Name="Close editor"
                            ToolTipService.ToolTip="Close editor. Your prompts are kept." VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                    </Button>
                </Grid>
                <ScrollViewer x:Name="Viewport" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12,10,12,10" Height="{Binding ActualHeight, ElementName=Viewport}" MinHeight="410">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="132" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Path Data="M8,0 L10,6 L16,8 L10,10 L8,16 L6,10 L0,8 L6,6 Z" Fill="#C6BDDF" Width="14" Height="14" Stretch="Uniform" />
                                    <TextBlock Text="Enhanced prompt" FontFamily="Segoe UI Variable Text" FontSize="13" FontWeight="SemiBold" Foreground="#F3F2F7" />
                                </StackPanel>
                                <Button x:Name="CopyButton" Content="Copy" Click="Copy" TabIndex="5" HorizontalAlignment="Right"
                                        Style="{StaticResource QuietButton}" IsEnabled="False"
                                        AutomationProperties.AutomationId="Copy" AutomationProperties.Name="Copy enhanced prompt" />
                            </Grid>
                            <TextBox x:Name="EnhancedPrompt" Grid.Row="1" Style="{StaticResource PromptField}" AcceptsReturn="True"
                                     PlaceholderText="Your clearer prompt will appear here. Review and edit it before you copy."
                                     TextWrapping="Wrap" MaxLength="32000" TabIndex="4" TextChanging="ResultChanging"
                                     AutomationProperties.AutomationId="EnhancedPrompt" AutomationProperties.Name="Enhanced prompt"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#20212D" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#20212D" />
                                </TextBox.Resources>
                            </TextBox>
                            <Border Grid.Row="2" Background="{StaticResource ComposerBrush}" BorderBrush="#55494960" BorderThickness="1" CornerRadius="16" Padding="10,8,8,7">
                                <Grid RowSpacing="4">
                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="32" /></Grid.RowDefinitions>
                                    <TextBox x:Name="RoughPrompt" Style="{StaticResource PromptField}" AcceptsReturn="True"
                                             PlaceholderText="Write your rough prompt…" TextWrapping="Wrap" MaxLength="32000" TabIndex="1"
                                             AutomationProperties.AutomationId="RoughPrompt" AutomationProperties.Name="Rough prompt"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <TextBox.Resources>
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#17181E" />
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#17181E" />
                                        </TextBox.Resources>
                                    </TextBox>
                                    <Grid Grid.Row="1">
                                        <Button x:Name="PasteButton" Content="Paste" Click="Paste" TabIndex="2" Style="{StaticResource QuietButton}"
                                                AutomationProperties.AutomationId="Paste" ToolTipService.ToolTip="Paste into rough prompt" />
                                        <Button x:Name="EnhanceButton" Content="Enhance" Click="Enhance" HorizontalAlignment="Right" TabIndex="3"
                                                MinWidth="96" Height="32" Padding="13,4" CornerRadius="16" Background="#F3F2F7" Foreground="#20212D"
                                                AutomationProperties.AutomationId="Enhance" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="3" Spacing="4">
                                <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" Height="2"
                                             AutomationProperties.Name="Enhancing" AutomationProperties.AutomationId="Progress" />
                                <TextBlock x:Name="Status" Text="Add your API key in Settings to begin." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="Status" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <TextBlock Grid.Row="4" Text="Enhance sends your prompt to the cloud. Usage charges may apply."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                        </Grid>
                    </Border>
                </ScrollViewer>

            </Grid>
        </Border>
    </Grid>
</Window>
