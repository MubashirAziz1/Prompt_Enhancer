<Window x:Class="PromptEnhancer.WinUI.LauncherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PromptEnhancer.WinUI" Title="Prompt Enhancer">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <local:FloatingButton x:Name="OpenButton" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Style="{StaticResource AccentButtonStyle}" Padding="6"
                AutomationProperties.AutomationId="OpenEditor" AutomationProperties.Name="Open prompt editor"
                ToolTipService.ToolTip="Open prompt editor. Drag to move. Right-click for Hide and Quit.">
            <Button.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Hide" Click="Hide" AutomationProperties.AutomationId="Hide" />
                    <MenuFlyoutItem Text="Quit" Click="Quit" AutomationProperties.AutomationId="Quit" />
                </MenuFlyout>
            </Button.ContextFlyout>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Prompt" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Enhancer" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
            </StackPanel>
        </local:FloatingButton>
    </Grid>
</Window>
