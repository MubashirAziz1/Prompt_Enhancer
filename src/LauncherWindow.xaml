<Window x:Class="PromptEnhancer.WinUI.LauncherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PromptEnhancer.WinUI" Title="Prompt Enhancer">
    <Grid x:Name="Root" Background="Transparent">
        <local:FloatingButton x:Name="OpenButton" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Padding="0" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="False"
                AutomationProperties.AutomationId="OpenEditor" AutomationProperties.Name="Open prompt editor"
                ToolTipService.ToolTip="Open prompt editor. Drag to move. Right-click for Hide and Quit.">
            <local:FloatingButton.Template>
                <ControlTemplate TargetType="local:FloatingButton">
                    <Grid Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    </Grid>
                </ControlTemplate>
            </local:FloatingButton.Template>
            <Button.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Hide" Click="Hide" AutomationProperties.AutomationId="Hide" />
                    <MenuFlyoutItem Text="Quit" Click="Quit" AutomationProperties.AutomationId="Quit" />
                </MenuFlyout>
            </Button.ContextFlyout>
            <local:LiquidBlobSurface x:Name="Blob" />
        </local:FloatingButton>
    </Grid>
</Window>
