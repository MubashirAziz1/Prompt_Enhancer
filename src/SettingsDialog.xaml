<ContentDialog x:Class="PromptEnhancer.WinUI.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings" PrimaryButtonText="Save" CloseButtonText="Cancel" DefaultButton="Primary"
    AutomationProperties.AutomationId="SettingsDialog" PrimaryButtonClick="SaveKey">
    <StackPanel Spacing="16" MinWidth="280">
        <PasswordBox x:Name="ApiKey" Header="OpenRouter API key" MaxLength="4096"
                     PasswordRevealMode="Hidden" AutomationProperties.AutomationId="ApiKey"
                     AutomationProperties.Name="OpenRouter API key" />
        <TextBlock Text="Stored with Windows protection for your Windows account. Leave blank to keep the saved key."
                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="CredentialStatus" Text="No key saved yet." TextWrapping="Wrap"
                   AutomationProperties.AutomationId="CredentialStatus" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</ContentDialog>
